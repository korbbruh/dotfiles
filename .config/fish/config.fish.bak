if status is-interactive
    # Starship custom prompt
    starship init fish | source

    # Direnv + Zoxide
    command -v direnv &>/dev/null && direnv hook fish | source
    command -v zoxide &>/dev/null && zoxide init fish --cmd cd | source

    # Better ls
    alias ls='eza --icons --group-directories-first -1'

    # Abbrs
    abbr lg lazygit
    abbr gd 'git diff'
    abbr ga 'git add .'
    abbr gc 'git commit -am'
    abbr gl 'git log'
    abbr gs 'git status'
    abbr gst 'git stash'
    abbr gsp 'git stash pop'
    abbr gp 'git push'
    abbr gpl 'git pull'
    abbr gsw 'git switch'
    abbr gsm 'git switch main'
    abbr gb 'git branch'
    abbr gbd 'git branch -d'
    abbr gco 'git checkout'
    abbr gsh 'git show'

    abbr l ls
    abbr ll 'ls -l'
    abbr la 'ls -a'
    abbr lla 'ls -la'

    # Neofetch Alias
    alias neofetch='fastfetch -c /examples/13'

    # For jumping between prompts in foot terminal
    function mark_prompt_start --on-event fish_prompt
        echo -en "\e]133;A\e\\"
    end
end

# Execute on login only on tty1
#if status is-login; and test (tty) = /dev/tty1
#  mango
#    clear
#end

function go-integrated
    if lsof /dev/nvidia* >/dev/null 2>&1
        echo "⚠️ Cannot switch! The following processes are still using the GPU:"
        lsof /dev/nvidia*
        return 1
    end

    echo "🚀 No active GPU processes found. Switching to Integrated mode..."
    sudo supergfxctl -m Integrated

    if set -q NIRI_SOCKET
        echo "👋 Exiting Niri..."
        niri msg action quit -s
    else if set -q HYPRLAND_INSTANCE_SIGNATURE
        echo "👋 Exiting Hyprland..."
        hyprctl dispatch exit
    else
        echo "✅ Mode changed. Please manually log out or reboot."
    end
end

function go-hybrid
    echo "🚀 Switching to Hybrid mode..."
    sudo supergfxctl -m Hybrid

    if set -q NIRI_SOCKET
        echo "👋 Exiting Niri..."
        niri msg action quit -s
    else if set -q HYPRLAND_INSTANCE_SIGNATURE
        echo "👋 Exiting Hyprland..."
        hyprctl dispatch exit
    else
        echo "✅ Mode changed. Please manually log out or reboot."
    end
end
